# Copia este archivo a .env y rellena las claves. Sin claves el simulador
# funciona igualmente con el intérprete local y la voz del navegador.

# Claude interpreta la fraseología del controlador (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo de Claude. claude-haiku-4-5 responde antes si la latencia importa más.
ATC_MODEL=claude-opus-5-5

# OpenAI se usa solo para audio: reconocimiento (STT) y voces de piloto (TTS)
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

PORT=8787
